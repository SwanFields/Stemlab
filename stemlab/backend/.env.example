REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
# Leave empty to use STORAGE_DIR/users.sqlite3; set to use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://stemlab:password@localhost:5432/stemlab
DATABASE_URL=
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JOB_TTL_HOURS=6

# demucs = real ML model | mock = DSP filters for development without torch
SEPARATOR=demucs
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=auto
