REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
# Leave empty to use STORAGE_DIR/users.sqlite3; set to use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://stemlab:password@localhost:5432/stemlab
DATABASE_URL=
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
JOB_TTL_HOURS=6

# Cloudflare R2 Object Storage (Optional: Prevents audio files from disappearing when server sleeps)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stemlab-audio

# demucs = real ML model | mock = DSP filters | modal = serverless GPU/CPU worker
SEPARATOR=demucs
MODAL_DEMUCS_URL=
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=auto
DEMUCS_SEGMENT=4
DEMUCS_JOBS=1
DEMUCS_SHIFTS=1
