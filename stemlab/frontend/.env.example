# API Backend URL
# - Development: http://localhost:8080 (or http://127.0.0.1:8000)
# - Production (Vercel): Optional. If left blank, Vercel will proxy /api to the destination defined in vercel.json.
#   If specified (e.g. https://stemlab-rn5j.onrender.com), the frontend can call the backend directly.
VITE_API_BASE=http://localhost:8080
