{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix stemlab/frontend install",
  "buildCommand": "npm --prefix stemlab/frontend run build",
  "outputDirectory": "stemlab/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://stemlab-rn5j.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
